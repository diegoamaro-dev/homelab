#!/usr/bin/env python3
"""
push-voice-context — push the Aurora single-line voice context into Home Assistant.

Phase F / F-3b (F3.2). Reads ai-stack/aurora/aurora-context-voice.txt (produced by
bin/aurora-context at 04:15) and writes it into the HA helper
`input_text.aurora_voice_context` via the HA REST service `input_text/set_value`.
The HA Ollama voice prompt renders that helper per-request with Jinja2 (AD-13), so the
first voice exchange of the day reflects the latest nightly context with no reload.

Runs as diego from cron at 04:20 (after aurora-context at 04:15). Fail-soft: a push
failure is logged and returns a non-zero exit code but never affects Home Assistant.

Credentials are read from ai-stack/.env (gitignored): HA_BASE_URL + HA_LLAT. The token
is never printed. HA_LLAT is the existing non-admin AURORA token; set_value is a normal
(non-admin) service, so no elevated privilege is required.

Usage:
  push-voice-context            push the current voice line
  push-voice-context --dry-run  resolve + validate inputs and print the payload; no POST
"""

import json
import sys
import urllib.error
import urllib.request
from datetime import datetime, timezone
from pathlib import Path

REPO_ROOT  = Path("/home/diego/homelab")
ENV_FILE   = REPO_ROOT / "ai-stack/.env"
VOICE_FILE = REPO_ROOT / "ai-stack/aurora/aurora-context-voice.txt"
ENTITY_ID  = "input_text.aurora_voice_context"
MAX_LEN    = 255          # matches the input_text helper `max:` (AD-13)
TIMEOUT_S  = 10


def log(msg: str) -> None:
    ts = datetime.now(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")
    print(f"{ts} push-voice-context: {msg}", file=sys.stderr)


def read_env(path: Path) -> dict:
    """Parse only the two keys we need; ignore everything else (least exposure)."""
    wanted = {"HA_BASE_URL", "HA_LLAT"}
    out: dict = {}
    for raw in path.read_text().splitlines():
        line = raw.strip()
        if not line or line.startswith("#") or "=" not in line:
            continue
        key, _, val = line.partition("=")
        key = key.strip()
        if key in wanted:
            out[key] = val.strip().strip('"').strip("'")
    return out


def main() -> int:
    dry_run = "--dry-run" in sys.argv[1:]

    # --- resolve inputs -----------------------------------------------------
    try:
        env = read_env(ENV_FILE)
    except OSError as exc:
        log(f"error: cannot read env file {ENV_FILE}: {exc}")
        return 1
    base_url = (env.get("HA_BASE_URL") or "").rstrip("/")
    token    = env.get("HA_LLAT") or ""
    if not base_url or not token:
        log("error: HA_BASE_URL or HA_LLAT missing from env")
        return 1

    try:
        value = VOICE_FILE.read_text().strip()
    except OSError as exc:
        log(f"error: cannot read voice file {VOICE_FILE}: {exc}")
        return 1
    if not value:
        log(f"error: voice file {VOICE_FILE} is empty")
        return 1

    if len(value) > MAX_LEN:
        log(f"warning: voice line {len(value)} > {MAX_LEN}; truncating to fit helper max")
        value = value[:MAX_LEN]

    try:
        age_min = (datetime.now().timestamp() - VOICE_FILE.stat().st_mtime) / 60.0
    except OSError:
        age_min = -1.0

    payload = {"entity_id": ENTITY_ID, "value": value}
    endpoint = f"{base_url}/api/services/input_text/set_value"

    if dry_run:
        log(f"DRY-RUN endpoint={endpoint}")
        log(f"DRY-RUN voice_mtime_age={age_min:.0f}min len={len(value)}")
        log(f"DRY-RUN payload={json.dumps(payload, ensure_ascii=False)}")
        return 0

    # --- push ---------------------------------------------------------------
    data = json.dumps(payload).encode("utf-8")
    req = urllib.request.Request(
        endpoint,
        data=data,
        method="POST",
        headers={
            "Authorization": f"Bearer {token}",
            "Content-Type": "application/json",
        },
    )
    try:
        with urllib.request.urlopen(req, timeout=TIMEOUT_S) as resp:
            code = resp.getcode()
    except urllib.error.HTTPError as exc:
        body = (exc.read().decode("utf-8", "replace") or "")[:200]
        log(f"error: HTTP {exc.code} from set_value: {body}")
        return 1
    except urllib.error.URLError as exc:
        log(f"error: cannot reach HA at {base_url}: {exc.reason}")
        return 1

    log(f"ok: set {ENTITY_ID} (len={len(value)}, voice_mtime_age={age_min:.0f}min, http={code})")
    return 0


if __name__ == "__main__":
    sys.exit(main())
