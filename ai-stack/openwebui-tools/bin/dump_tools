#!/usr/bin/env python3
"""
dump_tools — pull every Open WebUI Tool from webui.db and write each
one's `content` field to ./tmp/<id>.dumped.py for diff against the
on-disk source.

Usage:
  dump_tools                 dump to ./tmp/
  dump_tools --out <dir>     dump elsewhere
  dump_tools --id <id>       dump only one Tool

Environment overrides same as install_tool.
"""
from __future__ import annotations

import argparse
import json
import os
import sys
import uuid
from pathlib import Path

try:
    import jwt
    import requests
except ImportError as e:
    sys.exit(f"missing dep: {e}. install with: pip install --user PyJWT requests")

REPO_ROOT = Path(__file__).resolve().parent.parent
ENV_FILE = Path(os.environ.get(
    "AMAROLAB_ENV_FILE",
    "/home/diego/homelab/ai-stack/.env",
))
OPENWEBUI_URL = os.environ.get("OPENWEBUI_URL", "http://127.0.0.1:3000").rstrip("/")
USER_ID = os.environ.get(
    "OPENWEBUI_USER_ID",
    "3a49344e-acf6-41a1-b28d-8cce95c36c2a",
)


def read_secret() -> str:
    s = os.environ.get("WEBUI_SECRET_KEY")
    if s:
        return s
    if not ENV_FILE.exists():
        sys.exit(f"[config] WEBUI_SECRET_KEY not in env and {ENV_FILE} missing")
    for line in ENV_FILE.read_text().splitlines():
        if line.startswith("WEBUI_SECRET_KEY="):
            return line.split("=", 1)[1].strip()
    sys.exit(f"[config] WEBUI_SECRET_KEY not found in {ENV_FILE}")


def mint_token(secret: str) -> str:
    return jwt.encode(
        {"id": USER_ID, "jti": str(uuid.uuid4())},
        secret,
        algorithm="HS256",
    )


def main(argv: list[str] | None = None) -> int:
    ap = argparse.ArgumentParser(description="Dump installed Open WebUI Tools to disk.")
    ap.add_argument("--out", default=str(REPO_ROOT / "tmp"))
    ap.add_argument("--id", default=None, help="Only dump this Tool id")
    args = ap.parse_args(argv)

    out = Path(args.out)
    out.mkdir(parents=True, exist_ok=True)

    headers = {"Authorization": f"Bearer {mint_token(read_secret())}"}

    if args.id:
        r = requests.get(f"{OPENWEBUI_URL}/api/v1/tools/id/{args.id}", headers=headers, timeout=10)
        r.raise_for_status()
        items = [r.json()]
    else:
        r = requests.get(f"{OPENWEBUI_URL}/api/v1/tools/", headers=headers, timeout=10)
        r.raise_for_status()
        # The list endpoint returns user-shaped tools without content; fetch each by id.
        ids = [t["id"] for t in r.json() if "id" in t]
        items = []
        for i in ids:
            rr = requests.get(f"{OPENWEBUI_URL}/api/v1/tools/id/{i}", headers=headers, timeout=10)
            if rr.status_code == 200:
                items.append(rr.json())

    for item in items:
        tid = item.get("id", "unknown")
        content = item.get("content", "")
        path = out / f"{tid}.dumped.py"
        path.write_text(content, encoding="utf-8")
        print(f"{tid} -> {path}  ({len(content)} chars, {len(item.get('specs') or [])} specs)")

    return 0


if __name__ == "__main__":
    raise SystemExit(main())
